PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=12
BCRYPT_PEPPER=

# CORS (comma separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173

# Ollama (primary receipt reader; runs natively on the Mac mini for GPU access)
# From a Docker container use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# Optional: Cloudflare Access service token when the Ollama endpoint sits behind a protected tunnel
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# Gemini (fallback when Ollama is down or fails)
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: second model used when GEMINI_MODEL is overloaded
GEMINI_FALLBACK_MODEL=

# Uploaded receipts
# Directory outside the app folder so uploads survive deploys (default: ~/cohouse-uploads)
UPLOAD_DIR=
# Public URL of this API, used in links to uploaded files
API_PUBLIC_URL=http://localhost:8080
