            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Passw0rd!\",\n  \"newPassword\": \"N3wPassw0rd!\",\n  \"repeatPassword\": \"N3wPassw0rd!\"\n}",
              "options": {
