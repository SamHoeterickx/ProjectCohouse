              "raw": "{{baseUrl}}/house/{{houseUuid}}/receipts/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "house",
                "{{houseUuid}}",
                "receipts",
                "scan"
              ]
            },
            "description": "Select a file in the body tab.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
