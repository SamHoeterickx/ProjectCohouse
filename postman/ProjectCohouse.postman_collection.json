{
  "info": {
    "name": "ProjectCohouse API",
    "description": "NestJS backend for ProjectCohouse (Tricount replacement).\n\nFlow: Register/Login (tokens are stored automatically) → Create house (houseUuid + inviteCode stored) → Me (userUuid stored) → expenses, balances, settlements.\n\nAll amounts are integers in cents. Dates are YYYY-MM-DD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userUuid",
      "value": ""
    },
    {
      "key": "memberUuid",
      "value": ""
    },
    {
      "key": "houseUuid",
      "value": ""
    },
    {
      "key": "inviteCode",
      "value": ""
    },
    {
      "key": "expenseUuid",
      "value": ""
    },
    {
      "key": "settlementUuid",
      "value": ""
    },
    {
      "key": "recurringUuid",
      "value": ""
    },
    {
      "key": "receiptUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Anna\",\n  \"email\": \"anna@example.com\",\n  \"password\": \"Passw0rd!\",\n  \"repeatPassword\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const d = json.data && json.data.data !== undefined ? json.data.data : json.data;",
                  "if (d && d.accessToken !== undefined) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "if (d && d.refreshToken !== undefined) pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"anna@example.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const d = json.data && json.data.data !== undefined ? json.data.data : json.data;",
                  "if (d && d.accessToken !== undefined) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "if (d && d.refreshToken !== undefined) pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates the refresh token; the old one stops working.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const d = json.data && json.data.data !== undefined ? json.data.data : json.data;",
                  "if (d && d.accessToken !== undefined) pm.collectionVariables.set('accessToken', d.accessToken);",
                  "if (d && d.refreshToken !== undefined) pm.collectionVariables.set('refreshToken', d.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Invalidates the refresh token."
          }
        }
      ]
    },
